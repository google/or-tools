load("@pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel:or_pybind_rules.bzl", "or_pybind_extension")

package(default_visibility = ["//visibility:public"])

# Python wrapper for model_builder.
or_pybind_extension(
    name = "model_builder_helper",
    srcs = ["model_builder_helper.cc"],
    tags = [
        "not_build:arm",
        "not_run:arm",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//ortools/linear_solver:linear_solver_cc_proto",
        "//ortools/linear_solver:model_exporter",
        "//ortools/linear_solver/wrappers:model_builder_helper",
        "@abseil-cpp//absl/base:dynamic_annotations",
        "@abseil-cpp//absl/hash",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
        "@eigen",
        "@pybind11_protobuf//pybind11_protobuf:native_proto_caster",
    ],
)

py_test(
    name = "model_builder_helper_test",
    srcs = ["model_builder_helper_test.py"],
    data = [
        "//ortools/linear_solver/testdata:large_model.mps.gz",
        "//ortools/linear_solver/testdata:maximization.mps",
    ],
    tags = [
        "noci",
        "not_build:arm",
        "not_run:arm",
    ],
    deps = [
        ":model_builder_helper",
        "//ortools/linear_solver:linear_solver_glop",
        "//ortools/linear_solver:linear_solver_pdlp",
        "//ortools/linear_solver:linear_solver_py_pb2",
        requirement("absl-py"),
        requirement("numpy"),
        requirement("scipy"),
    ],
)

py_library(
    name = "model_builder_numbers",
    srcs = ["model_builder_numbers.py"],
    deps = [
        requirement("numpy"),
    ],
)

py_library(
    name = "model_builder",
    srcs = ["model_builder.py"],
    tags = [
        "not_build:arm",
        "not_run:arm",
    ],
    deps = [
        ":model_builder_helper",
        ":model_builder_numbers",
        "//ortools/linear_solver:linear_solver_py_pb2",
        requirement("numpy"),
        requirement("pandas"),
    ],
)

py_test(
    name = "model_builder_test",
    srcs = ["model_builder_test.py"],
    data = [
        "//ortools/linear_solver/testdata:maximization.mps",
        "//ortools/linear_solver/testdata:small_model.lp",
    ],
    tags = [
        "noci",
        "not_build:arm",
        "not_run:arm",
    ],
    deps = [
        ":model_builder",
        ":model_builder_helper",
        "//ortools/linear_solver:linear_solver_glop",
        "//ortools/linear_solver:linear_solver_py_pb2",
        requirement("absl-py"),
        requirement("numpy"),
        requirement("pandas"),
        "@protobuf//:protobuf_python",
    ],
)

py_binary(
    name = "solve_model",
    srcs = ["solve_model.py"],
    tags = [
        "not_build:arm",
        "not_run:arm",
    ],
    deps = [
        ":model_builder",
        requirement("absl-py"),
    ],
)

or_pybind_extension(
    name = "pywraplp",
    srcs = ["pywraplp.cc"],
    visibility = ["//visibility:public"],
    deps = [
        "//ortools/linear_solver:linear_solver_all",
        "//ortools/linear_solver:linear_solver_cc_proto",
        "//ortools/linear_solver:linear_solver_lib",
        "//ortools/linear_solver:model_exporter",
        "//ortools/linear_solver:model_validator",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:inlined_vector",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@pybind11_protobuf//pybind11_protobuf:native_proto_caster",
    ],
)

py_test(
    name = "pywraplp_test",
    size = "small",
    srcs = ["pywraplp_test.py"],
    deps = [
        ":pywraplp",
        "//ortools/linear_solver:linear_solver_bop",
        "//ortools/linear_solver:linear_solver_glop",
        "//ortools/linear_solver:linear_solver_pdlp",
        "//ortools/linear_solver:linear_solver_py_pb2",
        requirement("absl-py"),
        "@protobuf//:protobuf_python",
    ],
)

py_test(
    name = "set_starting_basis_test",
    size = "small",
    srcs = ["set_starting_basis_test.py"],
    deps = [
        ":pywraplp",
        "//ortools/linear_solver:linear_solver_all",
        requirement("absl-py"),
    ],
)

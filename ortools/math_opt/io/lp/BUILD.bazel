load("//bazel:or_cc_rules.bzl", "or_cc_library", "or_cc_test")

package(default_visibility = ["//ortools/math_opt:__subpackages__"])

or_cc_library(
    name = "lp_model",
    srcs = ["lp_model.cc"],
    hdrs = ["lp_model.h"],
    deps = [
        ":lp_name",
        "//ortools/base:status_builder",
        "//ortools/base:strong_int",
        "//ortools/base:strong_vector",
        "//ortools/util:fp_roundtrip_conv",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_macros",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
    ],
)

or_cc_test(
    name = "lp_model_test",
    srcs = ["lp_model_test.cc"],
    deps = [
        ":lp_model",
        ":matchers",
        "//ortools/base:gmock_main",
        "@abseil-cpp//absl/status",
    ],
)

or_cc_library(
    name = "matchers",
    testonly = 1,
    srcs = ["matchers.cc"],
    hdrs = ["matchers.h"],
    deps = [
        ":lp_model",
        ":model_utils",
        "//ortools/base:gmock",
    ],
)

or_cc_test(
    name = "matchers_test",
    srcs = ["matchers_test.cc"],
    deps = [
        ":lp_model",
        ":matchers",
        "//ortools/base:gmock_main",
    ],
)

or_cc_library(
    name = "lp_name",
    srcs = ["lp_name.cc"],
    hdrs = ["lp_name.h"],
    deps = [
        "//ortools/base:status_builder",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
    ],
)

or_cc_test(
    name = "lp_name_test",
    srcs = ["lp_name_test.cc"],
    deps = [
        ":lp_name",
        "//ortools/base:gmock_main",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
    ],
)

or_cc_library(
    name = "model_utils",
    srcs = ["model_utils.cc"],
    hdrs = ["model_utils.h"],
    deps = [
        ":lp_model",
        "//ortools/base:status_builder",
        "//ortools/base:strong_vector",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status:status_macros",
        "@abseil-cpp//absl/status:statusor",
    ],
)

or_cc_test(
    name = "model_utils_test",
    srcs = ["model_utils_test.cc"],
    deps = [
        ":lp_model",
        ":matchers",
        ":model_utils",
        "//ortools/base:gmock_main",
        "//ortools/base:strong_vector",
        "@abseil-cpp//absl/status",
    ],
)
